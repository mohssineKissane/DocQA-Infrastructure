# ===========================================
# DocQA-MS Environment Configuration
# ===========================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!

# ===========================================
# PostgreSQL Database Configuration
# ===========================================
POSTGRES_USER=docqa_admin
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_PORT=5432

# ===========================================
# RabbitMQ Configuration
# ===========================================
RABBITMQ_USER=docqa_rabbit
RABBITMQ_PASSWORD=change_this_rabbit_password
RABBITMQ_VHOST=docqa
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ===========================================
# MinIO Object Storage Configuration
# ===========================================
MINIO_ROOT_USER=docqa_minio
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===========================================
# Microservices Ports
# ===========================================
DOCINGESTOR_PORT=8001
DEID_PORT=8002
SEMANTIC_INDEXER_PORT=8003
LLMQA_PORT=8004

# ===========================================
# AI/ML Model Configuration
# ===========================================
# Embedding model for SemanticIndexer
# Options: all-MiniLM-L6-v2, Bio_ClinicalBERT, etc.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM model for QA
# Options: llama-2-7b-chat, mistral-7b-instruct, etc.
LLM_MODEL=llama-2-7b-chat.gguf

# Number of top results to retrieve from FAISS
TOP_K_RESULTS=5

# ===========================================
# Application Configuration
# ===========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Environment: development, staging, production
ENVIRONMENT=development

# ===========================================
# Security (Production)
# ===========================================
# JWT secret for API authentication (add when implementing Auth0)
# JWT_SECRET=your_jwt_secret_here

# Allowed CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
